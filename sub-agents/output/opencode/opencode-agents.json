      "description": "Analiza criterios de aceptación buscando ambigüedades, vaguedades o suposiciones. Retorna lista de preguntas clarificadoras.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.1,
      "color": "#FFEB3B",
      "tools": {
        "read": true,
        "search": true,
        "glob": true,
        "grep": true,
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false
      },
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "task": {
          "*": "deny"
        }
      },
