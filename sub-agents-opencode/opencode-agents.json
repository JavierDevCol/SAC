{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "validador-calidad": {
      "description": "Valida CAs, alineación arquitectónica y existencia de archivos",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.1,
      "color": "#4CAF50",
      "tools": {
        "read": true,
        "search": true,
        "glob": true,
        "grep": true,
        "write": false,
        "edit": false,
        "bash": false,
        "webfetch": false
      },
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "deny",
        "task": {
          "*": "deny"
        }
      }
    },
    "validador-compilacion": {
      "description": "Verifica compilación y tests. Agnóstico al lenguaje.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.1,
      "color": "#FF9800",
      "tools": {
        "read": true,
        "search": true,
        "bash": true,
        "glob": true,
        "write": false,
        "edit": false,
        "webfetch": false
      },
      "permission": {
        "edit": "deny",
        "bash": "allow",
        "webfetch": "deny",
        "task": {
          "*": "deny"
        }
      }
    }
  }
}
